# ─── Serveur ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Chemin du fichier SQLite (relatif au dossier server/)
DATABASE_FILE=data/cercle.db

# ─── Authentification ────────────────────────────────────────────────────
APP_USERNAME=moi
# Obligatoire en production. En développement, défaut : « cercle ».
APP_PASSWORD=
APP_DISPLAY_NAME=Moi
# true derrière HTTPS (forcé à true en production)
COOKIE_SECURE=
SESSION_TTL_DAYS=30

# ─── Intelligence artificielle ───────────────────────────────────────────
# auto : Claude si ANTHROPIC_API_KEY est définie, sinon simulation locale
# anthropic | local
AI_PROVIDER=auto
# Clé API Anthropic (https://console.anthropic.com). Ne jamais la committer.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=low
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=30000
# Repli serveur automatique d'Anthropic en cas de refus du modèle
AI_SERVER_FALLBACKS=true

# ─── Automatisations ─────────────────────────────────────────────────────
# demo : délais divisés (12 par défaut) pour tester en quelques secondes
SIMULATION_SPEED=normal
SCHEDULER_INTERVAL_MS=1000
SEED_ON_EMPTY=true

# ─── Divers ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info
# Servir le client construit (client/dist) depuis le serveur (true en production)
SERVE_CLIENT=
# Origine autorisée pour Socket.IO si le client est servi ailleurs
CORS_ORIGIN=
